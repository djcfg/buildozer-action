#:kivy 2.3.0
# Стиль кнопок. Цвет передаётся из Python через background_color.
# Файл называется ppu_ui.kv (не ppu.kv), чтобы Kivy не загрузил его дважды
# автоматически по имени класса PPUApp.

<PpuButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0.16, 0.45, 0.68, 1)
    color: (0.95, 0.96, 0.97, 1)
    font_size: '15sp'
    text_size: self.size
    halign: 'center'
    valign: 'middle'
    canvas.before:
        Color:
            rgba: (self.background_color[0], self.background_color[1], self.background_color[2], 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
        Color:
            rgba: (0, 0, 0, 0.28) if self.state == 'down' else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
